<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <ImageView
        android:id="@+id/receive_settings_file_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/receive_settings_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="@color/primary_text" />
        <TextView
            android:id="@+id/receive_settings_file_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/receive_settings_file_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/incoming_settings_rename_file"
        android:padding="12dp"
        android:src="@drawable/ic_edit"
        android:tint="@color/primary_text" />
    <CheckBox
        android:id="@+id/receive_settings_file_check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/incoming_settings_select_file" />
</LinearLayout>
