<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/brand_primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/settings_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigate_up"
            android:padding="12dp"
            android:src="?android:attr/homeAsUpIndicator"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/settings_list_top_padding">

            <TextView
                style="@style/SettingsListSection"
                android:layout_marginTop="@dimen/settings_list_top_padding"
                android:text="@string/settings_general_section" />

            <LinearLayout
                android:id="@+id/language_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/language_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_language"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_language" />
                    <TextView
                        android:id="@+id/language_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_color_row"
                style="@style/SettingsListRow.Single">
                <ImageView
                    android:id="@+id/theme_color_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_palette"
                    android:tint="@color/secondary_text" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    style="@style/SettingsListTitle"
                    android:text="@string/settings_theme_color" />
                <View
                    android:id="@+id/theme_color_swatch"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/device_info_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/device_info_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_device"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_device_information" />
                    <TextView
                        android:id="@+id/device_info_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hide_ipv6_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/hide_ipv6_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_router"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_hide_ipv6_addresses" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_hide_ipv6_addresses_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/hide_ipv6_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keep_screen_awake_row"
                style="@style/SettingsListRow.Single">
                <ImageView
                    android:id="@+id/keep_screen_awake_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_brightness"
                    android:tint="@color/secondary_text" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    style="@style/SettingsListTitle"
                    android:text="@string/settings_keep_screen_awake" />
                <Switch
                    android:id="@+id/keep_screen_awake_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/item_border" />
            <TextView
                style="@style/SettingsListSection"
                android:text="@string/settings_receive_section" />

            <LinearLayout
                android:id="@+id/auto_save_row"
                style="@style/SettingsListRow.Single">
                <ImageView
                    android:id="@+id/auto_save_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/secondary_text" />
                <TextView
                    style="@style/SettingsListTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:text="@string/settings_auto_save" />
                <Switch
                    android:id="@+id/auto_save_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/receive_pin_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/receive_pin_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_receive_pin" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_receive_pin_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/receive_pin_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/receive_directory_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/receive_directory_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_folder_check"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_receive_directory" />
                    <TextView
                        android:id="@+id/receive_directory_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/save_history_row"
                style="@style/SettingsListRow.Single">
                <ImageView
                    android:id="@+id/save_history_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_history"
                    android:tint="@color/secondary_text" />
                <TextView
                    style="@style/SettingsListTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:text="@string/settings_save_history" />
                <Switch
                    android:id="@+id/save_history_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/verify_received_checksums_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/verify_received_checksums_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_verified"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_verify_received_checksums" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_verify_received_checksums_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/verify_received_checksums_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/item_border" />
            <TextView
                style="@style/SettingsListSection"
                android:text="@string/settings_send_section" />

            <LinearLayout
                android:id="@+id/checksum_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/checksum_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_verified"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_verify_file_integrity" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_verify_file_integrity_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/checksum_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/item_border" />
            <TextView
                style="@style/SettingsListSection"
                android:text="@string/settings_network_section" />

            <LinearLayout
                android:id="@+id/server_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/server_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_server"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_server" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_server_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/server_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/port_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/port_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_port"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/port_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_port" />
                    <TextView
                        android:id="@+id/port_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/network_interfaces_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/network_interfaces_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_router"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_network_interfaces" />
                    <TextView
                        android:id="@+id/network_interfaces_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/encryption_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/encryption_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_marginEnd="@dimen/settings_list_control_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_encryption" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_encryption_summary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/encryption_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/multicast_address_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/multicast_address_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_share"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/multicast_address_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_multicast_address" />
                    <TextView
                        android:id="@+id/multicast_address_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/item_border" />
            <TextView
                style="@style/SettingsListSection"
                android:text="@string/settings_about_section" />

            <LinearLayout
                android:id="@+id/version_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/version_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_info"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/version_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_version" />
                    <TextView
                        android:id="@+id/version_value"
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/changelog_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/changelog_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_changelog"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/changelog" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_changelog_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/source_code_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/source_code_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_code"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_source_code" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_source_code_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feedback_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/feedback_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_feedback"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/feedback_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_feedback" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_feedback_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/license_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/license_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_description"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/license_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_license" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_license_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/third_party_licenses_row"
                style="@style/SettingsListRow.Adaptive">
                <ImageView
                    android:id="@+id/third_party_licenses_icon"
                    android:layout_width="@dimen/settings_list_icon_size"
                    android:layout_height="@dimen/settings_list_icon_size"
                    android:src="@drawable/ic_description"
                    android:tint="@color/secondary_text" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_list_content_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/third_party_licenses_title"
                        style="@style/SettingsListTitle"
                        android:text="@string/settings_third_party_licenses" />
                    <TextView
                        style="@style/SettingsListSummary"
                        android:layout_marginTop="@dimen/settings_list_summary_spacing"
                        android:text="@string/settings_third_party_licenses_summary" />
