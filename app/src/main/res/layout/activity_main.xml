<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:elevation="0dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/history_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/action_button_ripple"
            android:contentDescription="@string/history"
            android:padding="12dp"
            android:src="@drawable/ic_history"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/action_button_ripple"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/local_endpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/local_endpoint_device_label"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/local_endpoint_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/local_endpoint_bind_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/local_endpoint_addresses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />
            </TableRow>
        </TableLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/discovery_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_transfer_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/view_transfers"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_devices"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/action_button_ripple"
            android:contentDescription="@string/refresh_devices"
            android:padding="4dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/brand_primary" />

        <ImageButton
            android:id="@+id/manual_send_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/action_button_ripple"
            android:contentDescription="@string/manual_send"
            android:padding="4dp"
            android:src="@drawable/ic_send"
            android:tint="@color/brand_primary" />

        <ImageButton
            android:id="@+id/favorites_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/action_button_ripple"
            android:contentDescription="@string/favorites"
            android:padding="4dp"
            android:src="@drawable/ic_favorite"
            android:tint="@color/brand_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="88dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pending_send_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pending_send_bar_background"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pending_send_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/view_pending_files"
            android:textColor="@color/brand_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_action_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="92dp"
        android:clipChildren="false"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_clipboard"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_clipboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_clipboard"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_content_paste"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_apps"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_apps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_apps"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_description"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_text"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_text"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_text"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_text"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_media"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_media"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_media"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_image"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_folder"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_folder"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_folder"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_folder"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/content_action_file"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/content_action_file"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mini_fab_background"
                android:contentDescription="@string/content_action_file"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_description"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/select_file_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/fab_background"
        android:contentDescription="@string/content_action_add"
        android:elevation="6dp"
        android:padding="16dp"
        android:scaleType="center"
        android:src="@drawable/ic_add"
        android:tint="@android:color/white" />

</FrameLayout>
